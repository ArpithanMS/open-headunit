<?xml version="1.0" encoding="utf-8"?>
<!-- Touch equivalent of a "hover" state: no pointer hover exists on a motorcycle touchscreen,
     so this lifts tonally on press instead - a plain surface-color change, standard ripple-like
     feedback. No accent color - see bg_ride_panel.xml. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/bg_ride_panel_pressed" />
    <item android:drawable="@drawable/bg_ride_panel" />
</selector>
