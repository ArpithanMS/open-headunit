<?xml version="1.0" encoding="utf-8"?>
<!-- Start Ride: the one dominant control per idle screen allowed a standing accent border
     (design spec "Actions and Safety" - "Use lime as an accent, but do not rely on lime alone",
     which is why the label/icon carry the state too, not just this border). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ride_primary_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/ride_accent_recording_bright" />
    <corners android:radius="4dp" />
</shape>
