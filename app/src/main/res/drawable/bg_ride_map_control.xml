<?xml version="1.0" encoding="utf-8"?>
<!-- Round map control button (zoom in/out) - routine chrome floating over the map, so it gets
     the same restrained treatment as bg_ride_panel: structural-divider border only, no accent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/ride_raised_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/ride_structural_divider" />
</shape>
