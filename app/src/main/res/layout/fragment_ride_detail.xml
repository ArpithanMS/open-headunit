<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Fills the whole screen behind the toolbar and stat overlays, like a Strava share card:
         the route IS the background, not a small box above a separate stats list. Always visible,
         no network/API-level requirement - the guaranteed-baseline route rendering. -->
    <com.andrerinas.openheadunit.ride.presentation.RouteGeometryView
        android:id="@+id/route_geometry_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty on purpose: RideDetailFragment adds a MapLibre MapView here programmatically, only
         on API 21+ (MapLibre's own minSdk - this app's github flavor is minSdk 16) and only once
         it decides to try loading a real basemap. Never declared in XML, since inflating
         org.maplibre.android.maps.MapView directly would load MapLibre's classes unconditionally
         on every API level, including ones it doesn't support. Sits above route_geometry_view and
         replaces it visually once a style has actually loaded; falls back to the plain route view
         beneath it if the device is too old or there's no network - see RideDetailFragment. -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrim (not transparent): the toolbar sits directly over the route, and a dense route
         segment or the cyan route line behind the title/back icon would otherwise impair
         legibility - contrast protection, same reasoning as the stat-row scrims below. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/ride_scrim"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:background="@android:color/transparent"
            app:title="@string/ride_detail_title"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="@color/ride_text_primary"
            app:navigationIconTint="@color/ride_text_primary"
            app:navigationContentDescription="@string/back" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Compact ride identity pill: date/time + weekday, replacing what used to be a single
         plain line - kept small and translucent on purpose so it reads as a caption, not a
         headline competing with the route or the summary dock below. -->
    <LinearLayout
        android:id="@+id/ride_identity_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ride_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/ride_detail_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/ride_detail_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- Single primary summary dock - a layered HUD replaces the previous two large floating
         side columns: top row is the three headline numbers (equal-weight columns, value over
         label), a hairline divider, then average moving speed as its own label-left/value-right
         line so it doesn't compete visually with the headline row. GPS diagnostics deliberately
         live outside this dock (see gps_quality_footnote) - ride performance and data-quality
         metadata are different priorities and shouldn't share one visual weight class. -->
    <LinearLayout
        android:id="@+id/stat_summary_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ride_scrim"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include layout="@layout/stat_overlay_item_centered" android:id="@+id/stat_distance"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/stat_overlay_item_centered" android:id="@+id/stat_duration"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/stat_overlay_item_centered" android:id="@+id/stat_max_speed"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/ride_structural_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stat_avg_speed_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ride_stat_avg_speed"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/stat_avg_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

        </LinearLayout>

    </LinearLayout>

    <!-- GPS diagnostics: technical metadata, not a ride-performance number - kept visually
         separate from stat_summary_dock (small, muted, its own corner) so it never competes with
         the primary summary. -->
    <TextView
        android:id="@+id/gps_quality_footnote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_ride_pill"
        android:textSize="10sp"
        android:textColor="@color/ride_text_tertiary"
        app:layout_constraintBottom_toTopOf="@id/stat_summary_dock"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Zoom controls - the map otherwise only responds to pinch, which is awkward one-handed
         (e.g. reviewing a ride at a stop, gloves on). -->
    <LinearLayout
        android:id="@+id/map_zoom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoom_in_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_ride_map_control_selector"
            android:gravity="center"
            android:text="@string/ride_map_zoom_in"
            android:textSize="24sp"
            android:textColor="@color/ride_text_primary"
            android:contentDescription="@string/ride_map_zoom_in_description" />

        <TextView
            android:id="@+id/zoom_out_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ride_map_control_selector"
            android:gravity="center"
            android:text="@string/ride_map_zoom_out"
            android:textSize="24sp"
            android:textColor="@color/ride_text_primary"
            android:contentDescription="@string/ride_map_zoom_out_description" />

    </LinearLayout>

    <TextView
        android:id="@+id/gps_quality_footnote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_ride_scrim"
        android:textSize="11sp"
        android:textColor="@color/ride_text_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Groups the "a real ride is loaded" content so RideDetailFragment can hide all of it at
         once for UiState.NotFound - deliberately excludes map_zoom_controls, which has its own
         independent isMapSupported() visibility that this must not clobber. -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ride_found_content_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ride_identity_pill,stat_summary_dock,gps_quality_footnote" />

    <TextView
        android:id="@+id/ride_not_found_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ride_detail_not_found"
        android:textSize="16sp"
        android:textColor="@color/ride_text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
