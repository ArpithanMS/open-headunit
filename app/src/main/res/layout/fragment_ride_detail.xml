<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Fills the whole screen behind the toolbar and stat overlays, like a Strava share card:
         the route IS the background, not a small box above a separate stats list. Always visible,
         no network/API-level requirement - the guaranteed-baseline route rendering. -->
    <com.andrerinas.openheadunit.ride.presentation.RouteGeometryView
        android:id="@+id/route_geometry_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty on purpose: RideDetailFragment adds a MapLibre MapView here programmatically, only
         on API 21+ (MapLibre's own minSdk - this app's github flavor is minSdk 16) and only once
         it decides to try loading a real basemap. Never declared in XML, since inflating
         org.maplibre.android.maps.MapView directly would load MapLibre's classes unconditionally
         on every API level, including ones it doesn't support. Sits above route_geometry_view and
         replaces it visually once a style has actually loaded; falls back to the plain route view
         beneath it if the device is too old or there's no network - see RideDetailFragment. -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrim (not transparent): the toolbar sits directly over the route, and a dense route
         segment or the cyan route line behind the title/back icon would otherwise impair
         legibility - contrast protection, same reasoning as the stat-row scrims below. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/ride_scrim"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:background="@android:color/transparent"
            app:title="@string/ride_detail_title"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="@color/ride_text_primary"
            app:navigationIconTint="@color/ride_text_primary"
            app:navigationContentDescription="@string/back" />

    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/ride_detail_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:background="@drawable/bg_ride_scrim"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp" />

    <!-- Left column: distance, moving time, avg speed. Scrim background protects contrast
         against the route drawn behind it (design spec: route text must stay readable for
         dense and sparse routes alike). -->
    <LinearLayout
        android:id="@+id/stat_column_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ride_scrim"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.6">

        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_distance" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_moving_time" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_avg_speed" />

    </LinearLayout>

    <!-- Right column: max speed, total duration. GPS quality is a data-quality footnote, not a
         headline number - it lives bottom-right in tiny type instead of this grid. -->
    <LinearLayout
        android:id="@+id/stat_column_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ride_scrim"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map_zoom_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.6">

        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_max_speed" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_duration" />

    </LinearLayout>

    <!-- Zoom controls - the map otherwise only responds to pinch, which is awkward one-handed
         (e.g. reviewing a ride at a stop, gloves on). -->
    <LinearLayout
        android:id="@+id/map_zoom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/zoom_in_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_ride_map_control_selector"
            android:gravity="center"
            android:text="@string/ride_map_zoom_in"
            android:textSize="24sp"
            android:textColor="@color/ride_text_primary"
            android:contentDescription="@string/ride_map_zoom_in_description" />

        <TextView
            android:id="@+id/zoom_out_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ride_map_control_selector"
            android:gravity="center"
            android:text="@string/ride_map_zoom_out"
            android:textSize="24sp"
            android:textColor="@color/ride_text_primary"
            android:contentDescription="@string/ride_map_zoom_out_description" />

    </LinearLayout>

    <TextView
        android:id="@+id/gps_quality_footnote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_ride_scrim"
        android:textSize="11sp"
        android:textColor="@color/ride_text_tertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Groups the "a real ride is loaded" content so RideDetailFragment can hide all of it at
         once for UiState.NotFound - deliberately excludes map_zoom_controls, which has its own
         independent isMapSupported() visibility that this must not clobber. -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/ride_found_content_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ride_detail_date,stat_column_start,stat_column_end,gps_quality_footnote" />

    <TextView
        android:id="@+id/ride_not_found_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ride_detail_not_found"
        android:textSize="16sp"
        android:textColor="@color/ride_text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
