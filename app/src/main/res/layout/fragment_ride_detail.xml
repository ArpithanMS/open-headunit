<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Fills the whole screen behind the toolbar and stat overlays, like a Strava share card:
         the route IS the background, not a small box above a separate stats list. -->
    <com.andrerinas.openheadunit.ride.presentation.RouteGeometryView
        android:id="@+id/route_geometry_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/ride_detail_title"
            app:navigationIcon="@drawable/ic_arrow_back_white"
            app:titleTextColor="?android:attr/textColorPrimary"
            app:navigationIconTint="?android:attr/textColorPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/ride_detail_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorSecondary"
        android:shadowColor="@color/text_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/app_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp" />

    <!-- Left column: distance, moving time, avg speed. -->
    <LinearLayout
        android:id="@+id/stat_column_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.6">

        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_distance" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_moving_time" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_avg_speed" />

    </LinearLayout>

    <!-- Right column: max speed, total duration, GPS quality. -->
    <LinearLayout
        android:id="@+id/stat_column_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.6">

        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_max_speed" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_duration" />
        <include layout="@layout/stat_overlay_item" android:id="@+id/stat_gps_quality" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
