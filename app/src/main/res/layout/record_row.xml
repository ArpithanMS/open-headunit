<?xml version="1.0" encoding="utf-8"?>
<!-- One lifetime-record row: label, headline value, and a small "which ride/when" subtext -
     tappable through to that ride's own Ride Detail when a record has a real rideId behind it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingVertical="12dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/record_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/record_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/record_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp" />

</LinearLayout>
